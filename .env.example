# Required: HuggingFace token for gated model access (Llama 3.2-3B)
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: LLM API key for chatbot and enhanced reports
# Supports OpenAI or Anthropic
LLM_API_KEY=
LLM_PROVIDER=openai  # openai or anthropic

# Capture settings
CAPTURE_DURATION=30        # Max scroll duration in seconds
CAPTURE_VIEWPORT_W=1440
CAPTURE_VIEWPORT_H=900
MAX_VIDEO_SIZE_MB=100
MAX_REDIRECTS=5
MAX_URL_LENGTH=2048

# TRIBE v2 inference
VIDEO_WEIGHT=0.6
TEXT_WEIGHT=0.4
MODEL_CACHE_DIR=./data/cache

# Server ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Data directory
DATA_DIR=./data
