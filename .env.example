# ── Inference ────────────────────────────────────────────────────────────────
# tribe: run Meta's TRIBE v2 on a local CUDA GPU (requires the tribev2 package).
# mock:  deterministic synthetic predictions so the full pipeline and UI can be
#        exercised on a machine without a GPU. Reports are labelled as mock.
INFERENCE_BACKEND=tribe

# Which TRIBE v2 input modalities to feed. The capture is a silent screen
# recording, so audio is never used. "video" alone skips the Llama-3.2-3B text
# encoder entirely (roughly halves peak VRAM) and does not need HF_TOKEN.
TRIBE_MODALITIES=video,text
TRIBE_MODEL_ID=facebook/tribev2
TRIBE_NUM_WORKERS=4

# Text modality: page text is turned into timed Word events by simulating a
# reader that follows the scroll at this pace. Context is the rolling window of
# preceding words handed to the language model for each word.
TEXT_READING_WPM=240
TEXT_CONTEXT_WORDS=256

# Required for the text modality: gated access to meta-llama/Llama-3.2-3B.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Optional LLM chatbot ─────────────────────────────────────────────────────
LLM_API_KEY=
LLM_PROVIDER=openai          # openai | anthropic
# LLM_MODEL=gpt-4o-mini      # defaults: gpt-4o-mini / claude-3-5-haiku-latest
# LLM_BASE_URL=              # override for OpenAI-compatible endpoints
CHAT_RATE_LIMIT_PER_MINUTE=20  # per client IP; the chat endpoint spends your LLM key

# ── Capture ──────────────────────────────────────────────────────────────────
CAPTURE_DURATION=30          # scroll duration in seconds
CAPTURE_VIEWPORT_W=1440
CAPTURE_VIEWPORT_H=900
MAX_VIDEO_SIZE_MB=100
MAX_REDIRECTS=5
MAX_URL_LENGTH=2048

# ── Paths & ports ────────────────────────────────────────────────────────────
DATA_DIR=./data
MODEL_CACHE_DIR=./data/cache
# The API has no authentication; keep it bound to localhost unless you put it
# behind an authenticating proxy.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# Used by the Next.js server to reach the backend.
BACKEND_URL=http://localhost:8000
